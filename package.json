{
  "name": "codemirror-lang-rdf",
  "private": true,
  "version": "0.0.0",
  "description": "CodeMirror/Lezer grammars for RDF 1.2, SPARQL 1.2 and SRL",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "pnpm run build && pnpm run typecheck && vitest run && playwright test",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "vendor-corpus": "node scripts/vendor-corpus.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.43.11",
    "@lezer/common": "^1.2.0",
    "@lezer/generator": "^1.7.1",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0",
    "@playwright/test": "^1.49.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@types/node": "^26.4.1",
    "codemirror-lang-sparql12": "workspace:^",
    "codemirror-lang-srl": "workspace:^",
    "codemirror-lang-turtle12": "workspace:^",
    "esbuild": "^0.28.2",
    "rollup": "^4.28.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
