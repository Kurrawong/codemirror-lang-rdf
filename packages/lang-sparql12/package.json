{
  "name": "@kurrawongai/codemirror-lang-sparql12",
  "version": "0.3.0",
  "description": "SPARQL 1.2 query and update language support for CodeMirror 6",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "codemirror",
    "lezer",
    "sparql",
    "sparql12",
    "rdf",
    "rdf12"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kurrawong/codemirror-lang-rdf.git",
    "directory": "packages/lang-sparql12"
  },
  "scripts": {
    "build": "rollup -c && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prepublishOnly": "cp ../../LICENSE ../../NOTICE . && pnpm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.7.1",
    "esbuild": "^0.28.2",
    "rollup": "^4.28.1",
    "typescript": "^7.0.2"
  }
}
