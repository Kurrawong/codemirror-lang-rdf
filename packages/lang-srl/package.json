{
  "name": "codemirror-lang-srl",
  "version": "0.1.0",
  "description": "SRL (SPARQL Rule Language) support for CodeMirror 6, on the SPARQL 1.2 Lezer grammar",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src", "README.md"],
  "keywords": ["codemirror", "lezer", "srl", "sparql-rl", "rules", "rdf"],
  "repository": { "type": "git", "url": "git+https://github.com/recalcitrantsupplant/codemirror-lang-rdf.git", "directory": "packages/lang-srl" },
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "rollup -c"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0",
    "codemirror-lang-sparql12": "workspace:^"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.28.1",
    "typescript": "^5.7.2"
  }
}
